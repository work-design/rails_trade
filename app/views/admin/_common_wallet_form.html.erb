<%= f.fields :wallet_price, all: { normal: nil }, wrap: { input: 'field' } do |ef| %>
  <div class="field is-horizontal" data-controller="enter">
    <label class="field-label is-normal"><%= wallet_template.name %></label>
    <div class="field-body">
      <%= ef.hidden_field :code, value: wallet_template.code, index: wallet_template.id, disabled: !f.object.wallet_price.key?(wallet_template.code) %>
      <%= ef.number_field :price, step: wallet_template.step, value: f.object.wallet_price.fetch(wallet_template.code, f.object.price.ceil(wallet_template.digit)), index: wallet_template.id, disabled: !f.object.wallet_price.key?(wallet_template.code) %>
      <div class="field is-narrow has-addons has-addons-middle">
        <span><%= wallet_template.unit %></span>
        <%= svg_tag 'plus', data: { action: 'click->enter#open' }, class: 'icon clickable' %>
        <%= svg_tag 'minus', data: { action: 'click->enter#close' }, class: 'icon clickable' %>
      </div>
    </div>
  </div>
<% end %>
