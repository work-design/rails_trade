<div class="p-3 scroll-wrapper">
<% Trade::Order.order(id: :desc).limit(7).each_with_index do |order, index| %>
  <p class="p-3 animation-scroll-step" style="animation-delay: <%= index * 3 %>s">
    <span>用户</span>
    <span><%= order.user_name.truncate(5) %></span>
    <span>于</span>
    <time><%= distance_time order.created_at %></time>
    <span>前下单成功</span>
  </p>
<% end %>
</div>
