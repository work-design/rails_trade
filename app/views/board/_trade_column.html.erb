<div class="card as-transparent">
  <div class="card-header">
    <span class="size-7 has-border-left-primary text-grey"><%= t('trade.board.orders.index.title') %></span>
  </div>
  <div class="card-content fixed-grid has-3-cols">
    <div class="grid">
      <%= link_to({ controller: 'trade/board/orders', state: 'init' }, class: 'cell has-column-centered') do %>
        <%= svg_tag 'boxes-packing', class: 'icon is-medium text-primary' %>
        <div class="text-grey size-7 mt-1"><%= Trade::Order.enum_i18n(:state, 'init') %></div>
      <% end %>
      <%= link_to({ controller: 'trade/board/orders', state: 'done' }, class: 'cell has-column-centered') do %>
        <%= svg_tag 'handshake', class: 'icon is-medium text-primary' %>
        <div class="text-grey size-7 mt-1"><%= Trade::Order.enum_i18n(:state, 'done') %></div>
      <% end %>
      <%= link_to({ controller: 'trade/board/orders', state: 'canceled' }, class: 'cell has-column-centered') do %>
        <%= svg_tag 'trash', class: 'icon is-medium text-primary' %>
        <div class="text-grey size-7 mt-1"><%= Trade::Order.enum_i18n(:state, 'canceled') %></div>
      <% end %>
    </div>
  </div>
</div>
