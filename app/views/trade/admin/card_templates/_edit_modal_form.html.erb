<%= form_with theme: 'modal', model: @card_template, url: { action: 'update' } do |f| %>
  <%= render 'modal_header' %>
  <section id="modal-card-body" class="modal-card-body">
    <%= render partial: 'form', locals: { f: f } %>
    <%= render partial: 'com/attachments/list_field', locals: { target: f.object.cover, f: f } %>
  </section>
  <%= f.submit %>
<% end %>
