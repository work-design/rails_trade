<td><%= model.grade %></td>
<td>
  <div class="is-several">
    <%= image_tag model.logo, class: 'image is-24x24' if model.logo.attached? %>
    <span><%= model.name %></span>
    <span class="tag"><%= model.code %></span>
  </div>
</td>
<td class="background-cover" style="background-image: url(<%= rails_blob_url(model.cover) if model.cover.attached? %>)">
  <span style="color: <%= model.text_color %>">文字颜色</span>
</td>
<td>
  <%= link_to({ controller: 'cards', card_template_id: model.id }, class: 'button is-small is-borderless flex-direction-column') do %>
    <strong><%= model.cards_count %></strong>
    <p class="size-7 text-grey"><%= t('.cards.index.title') %></p>
  <% end %>
</td>
<td><%= model.promote&.name %></td>
<td>
  <%= form_with theme: 'switch', model: model, url: { action: 'update', id: model.id }, data: { controller: 'input' } do |f| %>
    <%= f.check_box :enabled, data: { action: 'input#submit' }, id: nil %>
  <% end %>
</td>
