<td>
  <span><%= model.name %></span>
  <div class="is-several">
  <%= link_to({ controller: 'crm/admin/wallets', contact_id: model.contact_id }, text: true) do %>
    <%= svg_tag 'user' %>
    <span class="family-monospace ml-1"><%= model.contact.title %></span>
  <% end %>
  </div>
</td>
<td>
  <span><%= model.amount.to_fs(:rounded, precision: model.wallet_template.digit) %></span>
  <span><%= model.wallet_template.unit %></span>
</td>
<td>
  <%= link_to({ controller: 'wallet_advances', wallet_id: model.id }, aria: { label: t('.wallet_advances.index.title') }, class: 'button is-small is-link is-light') do %>
    <%= svg_tag 'gem' %>
    <span class="ml-1"><%= model.advances_amount.to_fs(:rounded, precision: model.wallet_template.digit) %></span>
    <span><%= model.wallet_template.unit %></span>
  <% end %>
</td>
<td>
  <%= link_to({ controller: 'wallet_payments', wallet_id: model.id }, aria: { label: t('.wallet_payments.index.title') }, class: 'button is-small is-link is-light') do %>
    <%= svg_tag 'credit-card' %>
    <span><%= model.payment_amount.to_fs(:rounded, precision: model.wallet_template.digit) %></span>
    <span><%= model.wallet_template.unit %></span>
  <% end %>
</td>
<td>
  <%= form_with theme: 'switch', model: model, url: { action: 'update', id: model.id }, data: { controller: 'input' } do |f| %>
    <%= f.checkbox :enabled, data: { action: 'input#submit' }, id: nil %>
  <% end %>
</td>
<td>
  <p><time data-controller="time"><%= model.created_at.to_fs(:iso8601) %></time></p>
</td>
