<%= button_to({ controller: 'payments', action: 'desk', desk_id: @desk.id }, class: 'button is-primary') do %>
  <span><%= t('.payments.desk.title') %></span>
<% end %>
<%= button_to({ action: 'done' }, data: { turbo_confirm: t('.done.confirm') }, class: 'button is-primary') do %>
  <span><%= t('.done.title') %></span>
<% end %>
<%=
  button_to(
    { controller: 'print/admin/home', action: 'inner' },
    params: { gid: @desk.to_gid.to_s, aim: 'order' },
    id: 'print-button',
    data: { controller: 'print-pos' },
    class: 'button is-primary'
  ) do
%>
  <%= svg_tag 'print' %>
  <span><%= t('print.admin.home.inner.title') %></span>
<% end %>
