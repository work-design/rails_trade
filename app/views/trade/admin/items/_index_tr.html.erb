<%=
  tr_tag(
    model,
    {
      action: url_for(action: 'deliver', id: model.id),
      icon: 'person-carry-box',
      title: t('.deliver.title'),
      position: 0
    },
    {
      href: url_for(controller: 'item/item_promotes', item_id: model.id),
      icon: 'gift',
      title: t('.item_promotes.index.title'),
      enable: false
    },
    {
      href: url_for(controller: 'holds', item_id: model.id),
      icon: 'handshake',
      title: t('.holds.index.title')
    },
    {
      href: url_for(action: 'carts', id: model.id),
      icon: 'cart-shopping',
      title: t('.items.carts.title')
    }
  ) { yield }
%>
