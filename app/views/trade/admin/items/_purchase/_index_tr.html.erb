<%=
  tr_tag(
    model,
    {
      href: url_for(controller: 'item/item_promotes', item_id: model.id),
      icon: 'gift',
      title: t('trade.admin.item_promotes.index.title')
    },
    {
      href: url_for(controller: 'holds', item_id: model.id),
      icon: 'face-meh',
      title: t('.holds.index.title')
    },
    id: "order_#{model.order_id}_#{model.id}"
  ) { yield }
%>
<%= render partial: 'purchase_tbody', layout: 'purchase_tr', collection: model.purchase_items.select(&:persisted?), as: :model %>
