<%= form_with theme: 'default_phone', model: @payment, scope: :payment, url: { action: 'create' } do |f| %>
  <%= f.hidden_field :type %>
  <%= f.fields :payment_orders do |ef| %>
    <%= ef.number_field :order_amount %>
    <%= ef.hidden_field :state %>
    <%= ef.hidden_field :order_id %>
  <% end %>
  <%= f.text_area :comment %>
  <%= render partial: 'com/attachments/list_field', locals: { target: f.object.proof, f: f } %>
  <%= f.submit %>
<% end %>
