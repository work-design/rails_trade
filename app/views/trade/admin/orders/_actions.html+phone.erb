<%= button_to({ action: 'destroy', id: model.id }, method: :delete, form: { data: { turbo_confirm: t('.destroy.confirm') } }, class: 'cell has-column-centered') do %>
  <%= svg_tag 'trash' %>
  <span><%= t('.destroy.title') %></span>
<% end %>
<%= button_to({ action: 'edit', id: model.id }, class: 'cell has-column-centered') do %>
  <%= svg_tag 'pencil' %>
  <span><%= t('.edit.title') %></span>
<% end %>
<%= button_to({ action: 'adjust_edit', id: model.id }, class: 'cell has-column-centered text-primary') do %>
  <%= svg_tag 'pen-clip-slash' %>
  <span><%= t('.orders.adjust_edit.title') %></span>
<% end %>
<%= link_to({ action: 'show', id: model.id }, class: 'cell has-column-centered') do %>
  <%= svg_tag 'eye' %>
  <span><%= t('.show.title') %></span>
<% end %>
<%= link_to({ controller: 'order/payment_orders', order_id: model.id }, class: 'cell has-column-centered') do %>
  <%= svg_tag 'credit-card' %>
  <span><%= t('trade.admin.order.payment_orders.index.title') %></span>
<% end %>
<%= button_to({ controller: 'scan_payments', action: 'batch' }, params: { ids: @order.id }, class: 'cell has-column-centered') do %>
  <%= svg_tag 'credit-card' %>
  <span><%= t('.scan_payments.batch.title') %></span>
<% end %>
<%= button_to({ controller: 'print/admin/home', action: 'inner' }, params: { gid: @order.to_gid.to_s, aim: 'receipt' }, class: 'cell has-column-centered') do %>
  <%= svg_tag 'print' %>
  <span><%= t('print.admin.home.inner.title') %></span>
<% end %>
