<div class="media as-boxed">
  <div class="media-left">
    <%= svg_tag 'location-dot' %>
  </div>
  <div class="media-content">
    <p>
      <strong><%= model.contact_person %></strong>
      <span><%= model.tel %></span>
      <% if model.station %>
        <span class="tag"><%= model.station.name %></span>
      <% end %>
    </p>
    <p class="text-grey size-7">
      <span><%= model.area.full_name %></span>
      <span><%= model.detail %></span>
    </p>
  </div>
</div>
