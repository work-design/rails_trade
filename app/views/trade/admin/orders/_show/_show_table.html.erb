<% if @order.aim_rent? %>
  <%= render 'rent_thead' %>
  <%= render partial: 'rent_tbody', layout: 'rent_tr', collection: @order.items, as: :model %>
<% elsif @order.all_purchase? %>
  <div>
    <dt></dt>
    <dd>
      <%= render layout: 'index_table' do %>
        <%= render 'purchase_thead' %>
        <%= render partial: 'purchase_tbody', layout: 'index_tr', collection: @order.items, as: :model %>
      <% end %>
    </dd>
  </div>
<% else %>
  <div>
    <dt></dt>
    <dd class="text-left">
      <%= render layout: 'index_table' do %>
        <%= render partial: 'index_tbody', layout: 'index_tr', collection: @order.items, as: :model %>
      <% end %>
    </dd>
  </div>
<% end %>
<div>
  <dt><%= Trade::Order.human_attribute_name(:item_amount) %></dt>
  <dd class="text-success"><%= @order.item_amount.to_money.format.html_safe %></dd>
</div>
<%= render partial: 'cart_promote', collection: @order.cart_promotes, as: :cart_promote %>
<div>
  <dt><%= Trade::Order.human_attribute_name(:adjust_amount) %></dt>
  <dd class="text-success"><%= @order.adjust_amount.to_money.format.html_safe %></dd>
</div>
<div>
  <dt><%= Trade::Order.human_attribute_name(:amount) %></dt>
  <dd><%= @order.amount.to_money.format.html_safe %></dd>
</div>
<div>
  <dt><%= Trade::Order.human_attribute_name(:contact_id) %></dt>
  <dd><%= link_to @order.contact_id, { controller: 'crm/admin/contacts', action: 'show', id: @order.contact_id }, target: '_blank' %></dd>
</div>
<div>
  <dt><%= Trade::Order.human_attribute_name(:payment_status) %></dt>
  <dd><%= @order.payment_status_i18n %></dd>
</div>
<div>
  <dt></dt>
  <dd>
    <%= render layout: 'index_table_without_thead' do %>
      <%= render partial: 'show_address', locals: { address: @order.address } if @order.address %>
    <% end %>
  </dd>
</div>
<div>
  <dt></dt>
  <dd>
    <%= render layout: 'index_table_without_thead' do %>
      <%= render partial: 'show_payment', collection: @order.payment_orders, as: :model %>
    <% end %>
  </dd>
</div>
