<div class="buttons are-small as-bottom">
  <%= button_to({ controller: 'print/admin/home', action: 'inner' }, params: { gid: @order.to_gid.to_s, aim: 'receipt' }, id: 'print-button', class: 'button') do %>
    <%= svg_tag 'print' %>
    <span><%= t('print.admin.home.inner.title') %></span>
  <% end %>
  <% if @order.can_pay? %>
    <%= button_to({ controller: 'scan_payments', action: 'batch' }, params: { ids: @order.id }, class: 'button is-link') do %>
      <%= svg_tag 'credit-card' %>
      <span><%= t('.scan_payments.batch.title') %></span>
    <% end %>
    <%= button_to({ action: 'payment_types', id: @order.id }, class: 'button is-link') do %>
      <%= svg_tag 'receipt' %>
      <span><%= t('.payment_types.title') %></span>
    <% end %>
  <% end %>
  <%= link_to({ action: 'purchase', id: @order.id }, class: 'button is-link') do %>
    <%= svg_tag 'cart-shopping' %>
    <span><%= t('.purchase.title') %></span>
  <% end %>
  <%= button_to({ action: 'adjust_edit', id: @order.id }, class: 'button is-info') do %>
    <%= svg_tag 'pen-clip' %>
    <span><%= t('.adjust_edit.title') %></span>
  <% end %>
  <%= button_to({ action: 'update', id: @order.id }, method: :patch, params: { 'order[state]': 'produced' }, class: 'button is-info') do %>
    <%= svg_tag 'box-check' %>
    <span>制作完成</span>
  <% end if ['init'].include?(@order.state) %>
</div>
