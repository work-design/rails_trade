<%= form_with url: { controller: 'hand_payments', action: 'batch' }, class: 'button_to' do %>
  <%= button_tag disabled: true, class: 'button is-success' do %>
    <%= svg_tag 'cash-register' %>
    <span class="ml-1"><%= t('.hand_payments.batch.title') %></span>
  <% end %>
<% end %>
<%= form_with url: { controller: 'scan_payments', action: 'batch' }, class: 'button_to' do %>
  <%= button_tag disabled: true, class: 'button is-warning' do %>
    <%= svg_tag 'qrcode' %>
    <span class="ml-1"><%= t('.scan_payments.batch.title') %></span>
  <% end %>
<% end %>
<%= form_with url: { action: 'batch_destroy' }, method: :delete, class: 'button_to' do %>
  <%= button_tag disabled: true, class: 'button is-danger' do %>
    <%= svg_tag 'trash-can' %>
    <span class="ml-1"><%= t('.batch_destroy.title') %></span>
  <% end %>
<% end %>
