<%=
  tr_tag(
    model,
    {
      action: url_for(action: 'payment_types', id: model.id),
      title: t('.payment_types.title')
    },
    {
      action: url_for(action: 'desk_edit', id: model.id),
      icon: 'pencil',
      title: t('.desk_edit.title')
    },
    {
      action: url_for(action: 'contact_edit', id: model.id),
      icon: 'pencil',
      title: t('.contact_edit.title')
    },
    icons: ['show', 'edit']
  ) { yield }
%>
