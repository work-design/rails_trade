<%= form_with theme: 'modal', model: @payment, scope: :payment, url: { controller: 'payments', action: 'confirm', desk_id: params[:desk_id] }, data: { controller: 'total' } do |f| %>
  <%= render 'modal_header' %>
  <section id="modal-card-body" class="modal-card-body">
    <%= f.hidden_field :type %>
    <%= f.fields :payment_orders do |ef| %>
      <div class="field-label is-normal">
        <% if f.object.payment_orders.size > 1 %>
          <span class="text-grey">第 <%= ef.index + 1 %> 次下单金额</span>
        <% else %>
          <span class="text-grey">下单金额</span>
        <% end %>
        <span><%= ef.object.order_amount.to_money.format.html_safe %></span>
      </div>
      <%= ef.hidden_field :order_amount %>
      <%= ef.hidden_field :state %>
      <%= ef.hidden_field :order_id %>
    <% end %>
    <%= f.number_field :adjust_amount, data: { total_target: 'reduce', action: 'total#updateReduce' } %>
    <%= f.number_field :total_amount, data: { total_target: 'total', action: 'total#updateTotal' } %>
  </section>
  <footer class="modal-card-foot">
    <button
      data-controller="scan bridge-scan"
      data-scan-form-value="create_scan"
      data-action="click->scan#form"
      data-report-url="<%= url_for(controller: 'scan_payments', action: 'create') %>"
      type="button"
      class="button is-medium is-primary"
      disabled
    >
      <%= svg_tag 'credit-card' %>
      <span><%= t('.scan_payments.create.title') %></span>
    </button>
    <%= f.submit nil, wrap: { submit: nil } %>
  </footer>
<% end %>
