<%=
  tr_tag(
    model,
    {
      action: url_for(controller: 'refunds', action: 'new', payment_id: model.id),
      icon: 'thumbs-down',
      title: t('.refunds.new.title')
    },
    {
      action: url_for(controller: 'payment_methods', action: 'show', id: model.payment_method_id.to_s),
      icon: 'cash-register',
      title: t('.payment_methods.show.title'),
      enable: model.payment_method.present?
    },
    {
      action: url_for(controller: 'payment_orders', action: 'confirmable', payment_id: model.id),
      icon: 'check-double',
      title: t('.payment_orders.new.title'),
      enable: model.payment_orders_count > 0
    },
    {
      action: url_for(controller: 'auditor/admin/audits', audited_type: 'Trade::Payment', audited_id: model.id),
      icon: 'comments',
      title: t('auditor.admin.audits.index.title')
    },
    {
      action: url_for(action: 'print', id: model.id),
      icon: 'print',
      title: t('.print.title')
    }
  ) { yield }
%>
