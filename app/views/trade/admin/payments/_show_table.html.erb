<div>
  <dt><%= Trade::Payment.human_attribute_name(:proof) %></dt>
  <dd><%= image_tag @payment.proof, class: 'image' if @payment.proof.attached? %></dd>
</div>
<div>
  <dt><%= Trade::Payment.human_attribute_name(:type) %></dt>
  <dd><%= @payment.type_i18n %></dd>
</div>
<% if @payment.is_a?(Trade::WalletPayment) %>
  <div>
    <dt><%= Trade::Payment.human_attribute_name(:wallet_id) %></dt>
    <dd><%= link_to @payment.wallet_id, { controller: 'wallets', action: 'show', id: @payment.wallet_id } %></dd>
  </div>
<% end %>
<div>
  <dt><%= Trade::Payment.human_attribute_name(:orders_amount) %></dt>
  <dd><%= @payment.orders_amount.to_money.format.html_safe %></dd>
</div>
<div>
  <dt><%= Trade::Payment.human_attribute_name(:adjust_amount) %></dt>
  <dd><%= @payment.adjust_amount.to_money.format.html_safe %></dd>
</div>
<div>
  <dt><%= Trade::Payment.human_attribute_name(:total_amount) %></dt>
  <dd><%= @payment.total_amount.to_money.format.html_safe %></dd>
</div>
