<td>
  <p><%= model.name %></p>
  <p>
    <span><%= model.short_name %></span>
    <% if model.code.present? %>
      <span>(<%= model.code %>)</span>
    <% end %>
  </p>
</td>
<td>
  <p><%= model.metering_i18n %></p>
  <p><%= model.unit&.name %></p>
</td>
<td>
  <%= form_with theme: 'switch', model: model, url: { action: 'update', id: model.id }, data: { controller: 'input' } do |f| %>
    <%= f.checkbox :editable, data: { action: 'input#submit' }, id: nil %>
  <% end %>
</td>
<td><%= model.sequence %></td>
