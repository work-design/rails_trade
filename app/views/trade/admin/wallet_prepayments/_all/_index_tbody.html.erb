<td>
  <p><%= model.wallet_template.name %></p>
  <p class="size-7 text-grey"><%= model.wallet_template.description %></p>
</td>
<td>
  <span><%= model.amount.to_fs(:rounded, precision: model.wallet_template.digit) %></span>
  <span><%= model.wallet_template.unit %></span>
</td>
<td class="family-monospace"><%= model.token %></td>
<td class="family-monospace"><%= model.secret %></td>
<td><time data-controller="time"><%= model.expire_at&.to_fs(:iso8601) %></time></td>
<td><time data-controller="time"><%= model.used_at&.to_fs(:iso8601) %></time></td>
