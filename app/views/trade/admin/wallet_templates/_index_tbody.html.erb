<td>
  <div class="is-several">
    <%= image_tag model.logo, class: 'image is-24x24' if model.logo.attached? %>
    <span><%= model.name %></span>
    <span class="tag"><%= model.code %></span>
  </div>
  <% if model.expire_min.present? %>
    <p><time data-controller="time"><%= model.expire_min.to_fs(:iso8601) %></time></p>
  <% end %>
  <% if model.expire_max.present? && model.expire_max > model.expire_min %>
    <p><time data-controller="time"><%= model.expire_max.to_fs(:iso8601) %></time></p>
  <% end %>
</td>
<td>
  <p><%= model.unit %></p>
  <p><%= model.digit %></p>
</td>
<td>
  <p><%= model.prepay_min %></p>
  <p><%= model.prepay_max %></p>
</td>
<td><%= model.limit %></td>
<td>
  <%= form_with theme: 'switch', model: model, url: { action: 'update', id: model.id }, data: { controller: 'input' } do |f| %>
    <%= f.check_box :enabled, data: { action: 'input#submit' }, id: nil %>
  <% end %>
</td>
<td>
  <%= link_to({ controller: 'wallet_prepayments', wallet_template_id: model.id }, aria: { label: t('.wallet_prepayments.index.title') }, class: 'button is-borderless') do %>
    <%= svg_tag 'box-archive' %>
    <span><%= model.wallet_prepayments_count %></span>
  <% end %>
</td>
<td>
  <%= link_to({ controller: 'custom_wallets', wallet_template_id: model.id }, aria: { label: t('trade.admin.cards.index.title') }, class: 'button is-borderless') do %>
    <span class="text-link"><%= model.wallets_count %></span>
  <% end %>
</td>
<td>
<% model.wallet_goods.each do |wallet_good| %>
  <span class="tags has-addons">
    <span class="tag"><%= wallet_good.good_type_i18n %></span>
    <span class="tag"><%= wallet_good.ratio %></span>
  </span>
<% end %>
</td>
