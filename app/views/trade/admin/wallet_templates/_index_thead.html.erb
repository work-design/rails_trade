<th>
  <p><%= Trade::WalletTemplate.human_attribute_name(:name) %></p>
  <p><%= Trade::WalletTemplate.human_attribute_name(:appid) %></p>
</th>
<th><%= Trade::WalletTemplate.human_attribute_name(:unit) %></th>
<th><%= Trade::WalletTemplate.human_attribute_name(:digit) %></th>
<th><%= Trade::WalletTemplate.human_attribute_name(:limit) %></th>
<th><%= Trade::WalletTemplate.human_attribute_name(:enabled) %></th>
<th>
  <%= link_to filter_params('wallets_count-desc': 1) do %>
    <span class="text-grey"><%= Trade::WalletTemplate.human_attribute_name(:wallets_count) %></span>
    <%= svg_tag 'arrow-down', class: "icon is-small #{params['wallets_count-desc'] ? 'text-success' : 'text-grey'}" %>
  <% end %>
</th>
