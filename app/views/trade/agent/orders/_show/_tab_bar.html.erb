<div class="buttons are-small as-bottom">
  <%= button_to({ controller: 'print/admin/home', action: 'inner' }, params: { gid: @order.to_gid.to_s, aim: 'receipt' }, class: 'button is-info') do %>
    <%= svg_tag 'print' %>
    <span><%= t('print.admin.home.inner.title') %></span>
  <% end %>
  <% if @order.can_pay? %>
    <%= button_to({ controller: 'scan_payments', action: 'batch' }, params: { ids: @order.id }, class: 'button is-link') do %>
      <%= svg_tag 'credit-card' %>
      <span><%= t('.scan_payments.batch.title') %></span>
    <% end %>
  <% end %>
  <%= link_to({ controller:'space/admin/desks', action: 'all' }, class: 'button is-link') do %>
    <%= svg_tag 'grid-dividers' %>
    <span><%= t('space.admin.desks.all.title') %></span>
  <% end %>
  <%= button_to({ action: 'adjust_edit', id: @order.id }, class: 'button is-info') do %>
    <%= svg_tag 'pen-clip' %>
    <span><%= t('.adjust_edit.title') %></span>
  <% end %>
</div>
