<%= button_to({ action: 'payment_types', id: @order.id }, class: 'button is-primary') do %>
  <span><%= t('.payment_types.title') %></span>
<% end if @order.can_pay? %>
<%= form_with url: { action: 'batch_receive' }, class: 'button_to' do |f| %>
  <%= button_tag disabled: true, class: 'button is-success' do %>
    <%= svg_tag 'cash-register' %>
    <span class="ml-1"><%= t('.batch_receive.title') %></span>
  <% end %>
<% end %>
<p id="check_total" class="ml-1 text-grey"></p>
