<div class="box is-padding-less">
  <div class="card is-wallet is-radiusless" style="background-image: url(<%= model.cover.url %>); padding-bottom: <%= model.cover_blob.height_by_width_ratio %>">
    <div class="card-header">
      <p class="card-header-title" style="color: <%= model.text_color %>">
        <span><%= model.name %></span>
        <span>（未开通）</span>
      </p>
    </div>
    <div class="card-content background-cover flex flex-direction-column-reverse" style="color: <%= model.text_color %>">
      <div class="size-7 text-weight-bold"><%= ex_simple_format model.description %></div>
    </div>
  </div>
  <% if model.purchases.present? %>
    <div class="fixed-grid has-3-cols m-3">
      <div class="grid">
        <%= render partial: 'purchase', collection: model.purchases %>
      </div>
    </div>
  <% else %>
    <%= render 'purchase_default' %>
  <% end %>
</div>
