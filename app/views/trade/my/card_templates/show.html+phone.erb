<%= render 'menu' if @card_templates.size > 1 %>

<% if @card %>
  <%= render partial: 'card', locals: { model: @card } %>
<% else %>
  <%= render partial: 'card_template', locals: { model: @card_template } %>
<% end %>

<% if @card_template.privileges.size > 0 %>
<div class="box is-padding-less">
  <div class="box-header">特权</div>
  <div class="fixed-grid has-3-count">
    <div class="grid">
      <%= render partial: 'privilege', collection: @card_template.privileges, as: :privilege %>
    </div>
  </div>
</div>
<% end %>
