<div class="box is-padding-less">
<div class="weui-form-preview">
  <div class="weui-form-preview__bd">
    <div class="weui-form-preview__item">
      <label class="weui-form-preview__label"><%= Trade::Hold.human_attribute_name(:rentable) %></label>
      <div class="weui-form-preview__value" data-controller="clipboard">
        <span data-clipboard-target="source"><%= @hold.rentable.code %></span>
        <span data-action="click->clipboard#copy" class="tag is-badge is-danger">复制</span>
        <div data-clipboard-target="toast" class="tag is-badge is-success display-none">
          <%= svg_tag 'check' %>
        </div>
      </div>
    </div>
    <% if @hold.rent_start_at.present? %>
    <div class="weui-form-preview__item">
      <label class="weui-form-preview__label"><%= Trade::Hold.human_attribute_name(:rent_start_at) %></label>
      <span class="weui-form-preview__value"><time data-controller="time" data-format="human"><%= @hold.rent_start_at&.to_fs(:iso8601) %></time></span>
    </div>
    <div class="weui-form-preview__item">
      <label class="weui-form-preview__label"><%= Trade::Hold.human_attribute_name(:amount) %></label>
      <span class="weui-form-preview__value"><%= @hold.amount.to_money.format.html_safe %></span>
    </div>
    <% end %>
  </div>
</div>
</div>
