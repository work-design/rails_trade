<%= form_with theme: nil, model: @order, url: { action: 'create' }, id: 'new_order', class: 'mt-3' do |f| %>
  <%= f.fields :items do |ef| %>
    <%= ef.hidden_field :good_type %>
    <%= ef.hidden_field :good_id %>
    <%= ef.hidden_field :aim %>
    <%= ef.hidden_field :status, value: 'ordered' %>
    <%# ef.hidden_field :extra, value: ef.object.extra.to_json %>
  <% end %>
<% end %>

<div class="box is-padding-less">
  <div class="box-body">
    <%= render partial: 'item', collection: @order.items, as: :item %>
    <div class="media">
      <div class="media-content">
        <span>总价：</span>
        <span><%= @order.amount.to_money.format.html_safe %></span>
      </div>
    </div>
  </div>
  <div class="box-footer">
    <%= submit_tag t('.create.title'), class: 'button is-rounded is-fullwidth is-primary', form: 'new_order' %>
  </div>
</div>
