<div class="media">
  <% if item.good.logo&.attached? %>
  <div class="media-left">
    <%= image_tag item.good.logo, class: 'image is-64x64' %>
  </div>
  <% end %>
  <div class="media-content">
    <h4 class="title is-6 mb-1"><%= item.good_name %></h4>
    <p class="text-danger"><%= item.amount.to_money.format.html_safe %></p>
  </div>
</div>
