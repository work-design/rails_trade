<%=
  form_with(
    theme: 'modal_line',
    model: @order,
    url: { action: 'payment_pending' },
    method: :post,
    skip_default_ids: true,
    id: 'payment_form'
  ) do |f|
%>
  <section class="modal-card-body">
    <%= render partial: 'payment_types_form', locals: { f: f } %>
  </section>
  <% if @order.checking_amount <= 0 %>
    <%= f.submit '确认支付' %>
  <% end %>
<% end %>
