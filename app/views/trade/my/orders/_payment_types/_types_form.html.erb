<%=
  form_with(
    theme: 'modal_line',
    model: @order,
    url: { action: @order.payment_types.include?('Trade::WalletPayment') ? 'payment_pending' : 'payment_confirm' },
    method: :post,
    id: 'payment_form'
  ) do |f|
%>
  <%= render partial: 'payment_types_form', locals: { f: f } %>
<% end %>
