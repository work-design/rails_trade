<%=
  form_with(
    theme: 'modal_line',
    model: @order,
    url: { action: 'payment_pending' },
    method: :post,
    id: 'payment_form'
  ) do |f|
%>
  <%= render 'modal_header' %>
  <div class="modal-card-body">
    <%= render partial: 'payment_types_form', locals: { f: f } %>
  </div>
<% end %>
<%= turbo_stream_from @order, channel: Trade::OrderChannel unless @order.all_paid? %>
