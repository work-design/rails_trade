<%=
  form_with(
    theme: 'modal_line',
    model: @order,
    url: { action: @order.payment_types.include?('Trade::WalletPayment') ? 'payment_pending' : 'payment_confirm' },
    method: :post,
    id: 'payment_form'
  ) do |f|
%>
  <%= render 'modal_header' %>
  <div class="modal-card-body">
    <%= render partial: 'payment_types_form', locals: { f: f } %>
  </div>
  <div class="modal-card-foot"></div>
<% end %>
