<%=
  form_with(
    theme: 'modal_line',
    model: @order,
    url: { action: 'payment_confirm' },
    method: :post,
    skip_default_ids: true,
    id: 'payment_form'
  ) do |f|
%>
  <%= render 'modal_header' %>
  <section id="modal-card-body" class="modal-card-body">
    <%= render partial: 'payment_types_form', locals: { f: f } %>
  </section>
  <% if @order.checking_amount > 0 %>
    <div class="modal-card-foot"></div>
  <% else %>
    <%= f.submit '确认' %>
  <% end %>
<% end %>
