<div class="weui-form-preview">
  <div class="weui-form-preview__bd">
    <div class="weui-form-preview__item">
      <label class="weui-form-preview__label"><%= Ship::Package.human_attribute_name(:code) %></label>
      <div data-controller="clipboard" class="weui-form-preview__value">
        <span data-clipboard-target="source"><%= packaged.good_item.code %></span>
        <span data-action="click->clipboard#copy" class="tag is-badge is-danger">复制</span>
        <div data-clipboard-target="toast" class="tag is-badge is-success display-none">
          <%= svg_tag 'check' %>
        </div>
      </div>
    </div>
    <div class="weui-form-preview__item">
      <label class="weui-form-preview__label"><%= Ship::Packaged.human_attribute_name(:good_item_id) %></label>
      <span class="weui-form-preview__value"><%= packaged.good_item_id %></span>
    </div>
    <div class="weui-form-preview__item">
      <label class="weui-form-preview__label"><%= Ship::Package.human_attribute_name(:state) %></label>
      <span class="weui-form-preview__value"><%= packaged.package.state_i18n %></span>
    </div>
  </div>
  <div class="weui-form-preview__ft">
    <%= link_to({ controller: 'packageds', action: 'show',id: packaged.id }, class: 'weui-form-preview__btn weui-form-preview__btn_primary', text: true) do %>
      <span>详情</span>
    <% end %>
  </div>
</div>
