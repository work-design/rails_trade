<div class="box">
  <div class="fixed-grid has-3-cols">
    <div class="grid">
      <%= render partial: 'advance', collection: @wallet_template.opened_advances.without_card, as: :advance, locals: { wallet_template: @wallet_template } %>
    </div>
  </div>
  <% @wallet_template.opened_advances.with_card.group_by(&:card_template).each do |card_template, advances| %>
    <div class="mb-1">
      <span><%= card_template.name %>专享</span>
      <span>点击开通</span>
    </div>
    <div class="fixed-grid has-3-cols">
      <div class="grid">
        <%= render partial: 'advance', collection: advances, as: :advance, locals: { wallet_template: @wallet_template } %>
      </div>
    </div>
  <% end %>
</div>
