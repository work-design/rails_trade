<%= form_with theme: nil, url: { action: 'token_create' }, id: 'create_scan' do |f| %>
  <div class="field has-addons mt-6">
    <div class="control is-expanded">
      <%= f.text_field :token, placeholder: '请输入券码', autocomplete: 'off', class: 'input is-medium' %>
    </div>
    <div
      data-controller="scan"
      data-scan-form-value="create_scan"
      data-action="click->scan#report"
      class="control"
    >
      <button type="button" class="button is-medium is-info">
        <%= svg_tag 'barcode-read', class: 'icon' %>
      </button>
    </div>
  </div>
  <%= f.submit '确认绑定', class: 'button is-rounded is-fullwidth is-primary mt-4' %>
<% end %>
