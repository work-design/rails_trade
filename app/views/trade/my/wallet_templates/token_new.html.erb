<%= form_with theme: nil, url: { action: 'token_create' }, id: 'create_scan' do |f| %>
  <div
    data-controller="scan"
    data-scan-regex-value="[^/]+$"
    class="field has-addons mt-6"
  >
    <div class="control is-expanded">
      <%= f.text_field :token, placeholder: '请输入券码', autocomplete: 'off', data: { scan_target: 'input' }, class: 'input is-medium' %>
    </div>
    <div data-action="click->scan#input" class="control">
      <button type="button" class="button is-medium is-info">
        <%= svg_tag 'barcode-read', class: 'icon' %>
      </button>
    </div>
  </div>
  <div id="error_tip"></div>
  <%= f.submit '确认绑定', class: 'button is-rounded is-fullwidth is-primary mt-4' %>
<% end %>
