<%= button_to({ controller: 'org/my/authorized_tokens', action: 'update' }, params: { member_id: model.id, return_url: params[:return_url] }, class: 'media') do %>
  <span class="media-content">
    <strong class="has-block-left mt-1">
      <%= image_tag model.organ.logo.variant(resize_to_limit: [150, 150]), class: 'image is-24x24' if model.organ.logo.attached? %>
      <span class="size-7"><%= model.organ.name %></span>
    </strong>
    <span class="is-block size-7 text-grey"><%= model.name %></span>
  </span>
  <span class="media-right has-inline-centered" data-controller="input">
    <% if model == current_client %>
      <%= svg_tag 'check' %>
    <% else %>
      <%= svg_tag 'chevron-right' %>
    <% end %>
  </span>
<% end %>
